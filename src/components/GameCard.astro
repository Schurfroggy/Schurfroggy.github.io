---
import { Image } from "astro:assets";
import { GAME_STATUS_LABEL, type Game } from "@/data/games";

type Props = { game: Game };

const { game } = Astro.props;
const { title, tagline, description, cover, tags, status, play, repo } = game;

/** Image prefers the play link, then falls back to the repo. */
const coverHref = play ?? repo;
const coverLabel = play ? `游玩 ${title}` : `查看 ${title} 项目`;
---

<article
  class:list={[
    "game-card group/card relative flex h-full flex-col overflow-hidden rounded-3xl",
    "border border-border/25 backdrop-blur-sm",
    "bg-linear-to-br from-accent/5 via-muted/10 to-transparent",
    "transition-all duration-300 ease-out",
    "hover:-translate-y-1 hover:border-accent/30 hover:shadow-xl hover:shadow-accent/10",
  ]}
>
  <!-- Preview -->
  <div class="relative aspect-video w-full overflow-hidden bg-foreground/5">
    {
      coverHref ? (
        <a
          href={coverHref}
          target="_blank"
          rel="noopener noreferrer"
          class="block h-full w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50"
          aria-label={`${coverLabel}（新标签页打开）`}
          tabindex="-1"
        >
          <Image
            src={cover}
            alt={`${title} 游戏画面预览`}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover/card:scale-[1.04]"
            loading="lazy"
            widths={[480, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </a>
      ) : (
        <Image
          src={cover}
          alt={`${title} 游戏画面预览`}
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover/card:scale-[1.04]"
          loading="lazy"
          widths={[480, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
        />
      )
    }

    <!-- Soft top scrim so the status pill stays readable on bright art -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-linear-to-b from-background/45 to-transparent"
      aria-hidden="true"
    >
    </div>

    <span class:list={["status-pill", `status-${status}`]}>
      <span class="status-dot" aria-hidden="true"></span>
      {GAME_STATUS_LABEL[status]}
    </span>
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
    <div>
      <h2
        class="text-xl font-bold tracking-tight transition-colors duration-200 group-hover/card:text-accent sm:text-2xl"
      >
        {title}
      </h2>
      <p class="mt-1 text-sm font-medium text-accent/90">{tagline}</p>
    </div>

    <p class="text-sm leading-relaxed text-foreground/65">{description}</p>

    <ul class="flex flex-wrap gap-1.5" role="list" aria-label="标签">
      {
        tags.map(tag => (
          <li class="rounded-full border border-border/20 bg-foreground/5 px-2.5 py-0.5 text-xs font-medium text-foreground/60">
            {tag}
          </li>
        ))
      }
    </ul>

    <div class="mt-auto flex flex-wrap items-center gap-2 pt-3">
      {
        play && (
          <a
            href={play}
            target="_blank"
            rel="noopener noreferrer"
            class="game-btn game-btn-primary"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.29-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z" />
            </svg>
            开始游戏
            <span class="sr-only">（新标签页打开）</span>
          </a>
        )
      }
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="game-btn game-btn-ghost"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z" />
            </svg>
            GitHub
            <span class="sr-only">（新标签页打开）</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .game-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .game-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .game-btn-primary {
    color: #fff;
    background: var(--accent);
    box-shadow: 0 6px 18px -8px color-mix(in srgb, var(--accent) 80%, transparent);
  }

  .game-btn-primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, #000);
    transform: translateY(-1px);
  }

  .game-btn-ghost {
    color: var(--foreground);
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    background: color-mix(in srgb, var(--background) 45%, transparent);
  }

  .game-btn-ghost:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* ─── Status pill ─── */
  .status-pill {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--foreground);
    background: color-mix(in srgb, var(--background) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    backdrop-filter: blur(10px) saturate(160%);
    -webkit-backdrop-filter: blur(10px) saturate(160%);
  }

  .status-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .status-playable {
    color: #16a34a;
  }

  .status-wip {
    color: #d97706;
  }

  .status-offline {
    color: #6b7280;
  }
</style>
