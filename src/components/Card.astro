---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getEntryPath } from "@/utils/contentEntry";
import Datetime from "./Datetime.astro";
import IconGallery from "@/assets/icons/IconGallery.svg";
import IconNovella from "@/assets/icons/IconNovella.svg";
import IconPost from "@/assets/icons/IconPost.svg";
import {
  getReadingMinutesForBlogEntry,
  getReadingMinutesForNovellaEntry,
} from "@/utils/readingTime";

type Props = {
  variant?: "h2" | "h3";
  featured?: boolean;
  class?: string;
} & (CollectionEntry<"blog"> | CollectionEntry<"galleries"> | CollectionEntry<"novella">);

const {
  variant: Heading = "h2",
  featured = false,
  class: extraClass,
  id,
  data,
  filePath,
  collection,
} = Astro.props;

const { title, description, pubDatetime } = data;
const modDatetime = "modDatetime" in data ? data.modDatetime : null;
const timezone = "timezone" in data ? data.timezone : undefined;
const href = getEntryPath({ collection, id, filePath });
const isGallery = collection === "galleries";
const isNovella = collection === "novella";
const isBlog = collection === "blog";
const readingMinutes =
  collection === "blog"
    ? getReadingMinutesForBlogEntry({ collection, filePath })
    : collection === "novella"
      ? getReadingMinutesForNovellaEntry({ collection, filePath })
    : null;
const headingId = `${collection}-${slugifyStr(String(id))}-title`;
const descriptionId = `${collection}-${slugifyStr(String(id))}-description`;
const viewTransitionName = slugifyStr(String(title).replaceAll(".", "-"));
---

<li
  class:list={[
    "card-glow group/card relative my-3 rounded-2xl p-4 sm:p-5",
    "border-2 backdrop-blur-md",
    "transition-[border-color,background-color,box-shadow,transform] duration-300 ease-out motion-reduce:transform-none motion-reduce:transition-none",
    "focus-within:-translate-y-0.5 hover:-translate-y-0.5",
    "focus-within:shadow-lg hover:shadow-lg",

    // Default posts: neutral frosted glass (not theme-preset surface / muted)
    !isGallery &&
      !featured && [
        "border-accent/55 bg-white/40 dark:bg-white/[0.06]",
        "focus-within:border-accent focus-within:bg-accent/14 hover:border-accent hover:bg-accent/14",
        "focus-within:shadow-accent/15 hover:shadow-accent/15",
      ],

    // Featured generic posts styling
    !isGallery &&
      featured && [
        "border-amber-500/70 bg-amber-500/18",
        "focus-within:border-amber-500 focus-within:bg-amber-500/26 hover:border-amber-500 hover:bg-amber-500/26",
        "focus-within:shadow-amber-500/15 hover:shadow-amber-500/15",
        "shadow-[0_0_20px_-5px_rgba(245,158,11,0.2)]",
      ],

    // Gallery variant styling
    isGallery &&
      !featured && [
        "border-purple-500/60 bg-purple-500/18",
        "focus-within:border-purple-500 focus-within:bg-purple-500/26 hover:border-purple-500 hover:bg-purple-500/26",
        "focus-within:shadow-purple-500/15 hover:shadow-purple-500/15",
      ],

    // Featured gallery styling
    isGallery &&
      featured && [
        "border-purple-500/85 bg-purple-500/24",
        "focus-within:border-purple-500 focus-within:bg-purple-500/32 hover:border-purple-500 hover:bg-purple-500/32",
        "focus-within:shadow-purple-500/25 hover:shadow-purple-500/25",
        "shadow-[0_0_20px_-5px_rgba(168,85,247,0.22)]",
      ],

    // Novella variant styling
    isNovella &&
      !featured && [
        "border-cyan-500/60 bg-cyan-500/18",
        "focus-within:border-cyan-500 focus-within:bg-cyan-500/26 hover:border-cyan-500 hover:bg-cyan-500/26",
        "focus-within:shadow-cyan-500/15 hover:shadow-cyan-500/15",
      ],

    // Featured novella styling
    isNovella &&
      featured && [
        "border-cyan-500/85 bg-cyan-500/24",
        "focus-within:border-cyan-500 focus-within:bg-cyan-500/32 hover:border-cyan-500 hover:bg-cyan-500/32",
        "focus-within:shadow-cyan-500/25 hover:shadow-cyan-500/25",
        "shadow-[0_0_20px_-5px_rgba(6,182,212,0.22)]",
      ],
    extraClass,
  ]}
>
  <!-- Cursor-following glow -->
  <div
    class:list={[
      "card-glow-effect pointer-events-none absolute inset-0 z-0 rounded-2xl transition-opacity duration-300 motion-reduce:transition-none",
      !isGallery && "opacity-0 group-focus-within/card:opacity-100 group-hover/card:opacity-100",
      isGallery && "opacity-100",
      isBlog && "card-glow-effect-post",
      isGallery && "card-glow-effect-gallery",
      isNovella && "card-glow-effect-novella",
    ]}
    aria-hidden="true"
  >
  </div>

  <div class="relative z-5">
    <a
      href={href}
      class:list={[
        "rounded-sm text-lg font-semibold text-foreground transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none",
        isGallery
          ? "group-hover/card:text-purple-400 focus-visible:ring-purple-500"
          : isNovella
            ? "group-hover/card:text-cyan-400 focus-visible:ring-cyan-500"
          : featured
            ? "group-hover/card:text-amber-500 focus-visible:ring-amber-500"
            : "group-hover/card:text-accent focus-visible:ring-accent",
      ]}
      aria-labelledby={headingId}
      aria-describedby={descriptionId}
      style={{ viewTransitionName }}
    >
      <Heading id={headingId} class="flex items-center gap-2">
        {
          isBlog && (
            <span
              aria-hidden="true"
              class="inline-flex items-center justify-center rounded-md bg-accent/10 p-1 text-accent/80 ring-1 ring-accent/20"
            >
              <IconPost class="size-4" />
            </span>
          )
        }
        {
          isGallery && (
            <span
              aria-hidden="true"
              class="inline-flex items-center justify-center rounded-md bg-purple-500/10 p-1 text-purple-400/80 ring-1 ring-purple-500/20"
            >
              <IconGallery class="size-4" />
            </span>
          )
        }
        {
          isNovella && (
            <span
              aria-hidden="true"
              class="inline-flex items-center justify-center rounded-md bg-cyan-500/10 p-1 text-cyan-400/80 ring-1 ring-cyan-500/20"
            >
              <IconNovella class="size-4" />
            </span>
          )
        }
        {isBlog && <span class="sr-only">Post:</span>}
        {isNovella && <span class="sr-only">Novella:</span>}
        {isGallery && <span class="sr-only">Gallery:</span>}
        {title}
      </Heading>
      <!-- Expand clickable area to whole card on top of everything, minus the description -->
      <span class="absolute -inset-4 z-10 sm:-inset-5" aria-hidden="true"
      ></span>
    </a>

    <div
      class="pointer-events-none relative z-20 mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1"
    >
      <Datetime
        pubDatetime={pubDatetime}
        modDatetime={modDatetime}
        timezone={timezone}
      />
      {
        readingMinutes != null && (
          <span class="inline-flex items-center gap-1 font-cartograph text-xs text-foreground/50">
            <svg
              class="size-3 shrink-0 text-accent/60"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 6v6l4 2" />
            </svg>
            {readingMinutes} min read
          </span>
        )
      }
    </div>

    <p
      id={descriptionId}
      class="pointer-events-auto relative z-20 mt-2 line-clamp-2 text-sm leading-relaxed text-foreground/75 select-text"
    >
      {description}
    </p>
  </div>
</li>

<style>
  .card-glow {
    contain: paint;
  }

  .card-glow-effect {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in oklab, var(--accent) 8%, transparent) 0%,
      color-mix(in oklab, var(--accent) 4%, transparent) 30%,
      color-mix(in oklab, var(--accent) 0.8%, transparent) 60%,
      transparent 80%
    );
    will-change: opacity;
  }

  .card-glow-effect-post {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in oklab, var(--accent) 16%, transparent) 0%,
      color-mix(in oklab, var(--accent) 9%, transparent) 35%,
      color-mix(in oklab, var(--accent) 2%, transparent) 65%,
      transparent 82%
    );
  }

  .card-glow-effect-gallery {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in oklab, rgb(168 85 247) 18%, transparent) 0%,
      color-mix(in oklab, rgb(168 85 247) 10%, transparent) 35%,
      color-mix(in oklab, rgb(168 85 247) 2%, transparent) 65%,
      transparent 82%
    );
  }

  .card-glow-effect-novella {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in oklab, rgb(6 182 212) 18%, transparent) 0%,
      color-mix(in oklab, rgb(6 182 212) 10%, transparent) 35%,
      color-mix(in oklab, rgb(6 182 212) 2%, transparent) 65%,
      transparent 82%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .card-glow-effect {
      background: none;
    }
  }
</style>
