---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = {
  title: string;
  description?: string;
  /** Shown in small caps above the page title; default: Status */
  kicker?: string;
};

const {
  title: pageTitle,
  description: pageDescription = SITE.desc,
  kicker = "Status",
} = Astro.props;
---

<Layout title={`${pageTitle} | ${SITE.title}`} description={pageDescription}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-16">
    <header class="mb-10 border-b border-border/20 pb-6">
      <div
        class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-8"
      >
        <div class="min-w-0 flex-1">
          <p
            class="mb-2 font-cartograph text-xs font-semibold tracking-[0.2em] text-accent/80 uppercase"
          >
            {kicker}
          </p>
          <h1
            class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
          >
            {pageTitle}
          </h1>
        </div>
        <div
          class="w-full min-w-0 sm:w-auto sm:max-w-[min(100%,22rem)] sm:shrink-0"
        >
          <slot name="header-extra" />
        </div>
      </div>
    </header>
    <div class="w-full max-w-app">
      <slot />
    </div>
  </main>
  <Footer />
</Layout>
