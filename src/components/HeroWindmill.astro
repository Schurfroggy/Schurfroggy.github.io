  .opacity-half {
    opacity: 0.5;
  }

  .opacity-quarter {
    opacity: 0.25;
  }

  .shooting-star {
    height: 3px;
    width: 3px;
    background: #ffffff3b;
    top: 30px;
    position: absolute;
    right: 40px;
    border-radius: 2px 0 0 2px;
    transform: translate(0px, 0px) rotate(-45deg);
    animation: shootingstar 5s ease-in-out infinite;
  }
  .shooting-star:before {
    content: "";
    height: 0;
    width: 0;
    border-top: 1px solid transparent;
    border-bottom: 2px solid transparent;
    border-left: 130px solid #ffffff3b;
    left: 3px;
    position: absolute;
  }

  @keyframes shootingstar {
    0% {
      transform: translate(0px, 0px) rotate(-45deg);
      opacity: 0.6;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      transform: translate(-300px, 300px) rotate(-45deg);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .windmill {
      animation: none;
    }
    .shooting-star {
      animation: none;
      opacity: 0.35;
    }
  }
</style>
