---
import { MUSIC_TRACKS } from "@/data/musicPlaylist";
/**
 * Home hero playlist player: local `src/assets/music` files, sequential or shuffle.
 * Audio loads on first play (`preload=none` until then).
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const hasMusic = MUSIC_TRACKS.length > 0;
---

{
  hasMusic && (
    <div
      id="intro-audio-player"
      class:list={["intro-audio-wrap", className]}
      data-has-music="true"
      role="region"
      aria-label="Music playlist"
    >
      <div class="intro-audio-art-col" aria-hidden="true">
        <div class="intro-audio-art-disc" id="intro-audio-art-disc">
          <img
            id="intro-audio-art-img"
            class="intro-audio-art-img"
            src={MUSIC_TRACKS[0]!.artwork}
            alt=""
            width="128"
            height="128"
            decoding="async"
          />
        </div>
      </div>

      <div class="intro-audio-body">
        <div class="intro-audio-top">
          <span class="intro-audio-prefix" aria-hidden="true">
            $
          </span>
          <span class="intro-audio-cmd" aria-hidden="true">
            play
          </span>

          <button
            type="button"
            id="intro-audio-btn-prev"
            class="intro-audio-icon-btn"
            title="Previous track"
            aria-label="Previous track"
          >
            <svg
              class="intro-audio-ctrl-icon"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M1.5 2.5H3.5V13.5H1.5V2.5zM4 8L12.5 2.5V13.5L4 8z" />
            </svg>
          </button>

          <button
            id="intro-audio-btn"
            class="intro-audio-btn"
            aria-label="Play music"
            type="button"
          >
            <svg
              id="intro-icon-play"
              class="intro-icon"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M3 2.5a.5.5 0 0 1 .765-.424l10 5.5a.5.5 0 0 1 0 .848l-10 5.5A.5.5 0 0 1 3 13.5v-11z" />
            </svg>
            <svg
              id="intro-icon-pause"
              class="intro-icon hidden"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z" />
            </svg>
          </button>

          <button
            type="button"
            id="intro-audio-btn-next"
            class="intro-audio-icon-btn"
            title="Next track"
            aria-label="Next track"
          >
            <svg
              class="intro-audio-ctrl-icon"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M3 2.5L11.5 8 3 13.5V2.5zM12 2.5h2.5v11H12v-11z" />
            </svg>
          </button>

          <button
            type="button"
            id="intro-audio-mode-btn"
            class="intro-audio-mode-btn"
            title="Toggle sequential or shuffle"
            aria-label="Playback mode: sequential"
            aria-pressed="false"
          >
            <span class="intro-audio-mode-text" aria-hidden="true" />
          </button>

          <div class="intro-audio-vol" title="Volume">
            <span class="intro-audio-vol-icon" aria-hidden="true">
              ▮
            </span>
            <input
              id="intro-audio-vol"
              class="intro-audio-vol-range"
              type="range"
              min="0"
              max="1"
              step="0.01"
              value="0.7"
              aria-label="Volume"
            />
          </div>

          <div class="intro-waveform" id="intro-waveform" aria-hidden="true">
            {Array.from({ length: 8 }).map((_, i) => (
              <span
                class="intro-wave-bar"
                style={`--delay: ${i * 0.07}s; --h: ${[55, 80, 40, 95, 65, 85, 45, 70][i]}%`}
              />
            ))}
          </div>
        </div>

        <p class="intro-audio-mid" id="intro-now-line">
          <span class="intro-label" id="intro-now-label" title="">
            LOADING…
          </span>
        </p>

        <div class="intro-audio-bottom">
          <div class="intro-audio-progress-wrap">
            <div
              class="intro-progress-track"
              id="intro-progress-track"
              role="slider"
              tabindex="0"
              aria-valuenow={0}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-label="Audio progress control"
            >
              <div class="intro-progress-bar" id="intro-progress-bar" />
            </div>
            <span class="intro-time" id="intro-time" aria-live="off">
              <>
                <span id="intro-current">0:00</span>
                <span class="opacity-30"> /</span>
                <span id="intro-total" class="opacity-30">
                  0:00
                </span>
              </>
            </span>
          </div>
        </div>
      </div>
    </div>
  )
}

<style>
  .intro-audio-wrap {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    flex-wrap: nowrap;
    gap: 0;
    min-height: 8.5rem;
    padding: 0.65rem 0.85rem 0.65rem 0.65rem;
    border-radius: 0.75rem;
    border: 2px solid color-mix(in srgb, var(--border) 72%, var(--accent) 28%);
    background: color-mix(in oklab, var(--muted) 12%, transparent);
    font-family: var(--font-cartograph, monospace);
    font-size: 0.9rem;
    color: var(--foreground);
    transition:
      border-color 0.35s ease,
      background 0.35s ease,
      box-shadow 0.35s ease;
    max-width: 100%;
    backdrop-filter: blur(4px);
    box-shadow: none;
  }

  .intro-audio-wrap.playing {
    border-color: var(--accent);
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--accent) 16%, transparent) 0%,
      color-mix(in oklab, var(--accent) 5%, transparent) 55%,
      color-mix(in oklab, var(--muted) 8%, transparent) 100%
    );
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent),
      0 12px 42px -14px color-mix(in oklab, var(--accent) 48%, transparent),
      0 0 32px -8px color-mix(in oklab, var(--accent) 38%, transparent);
  }

  .intro-audio-art-col {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    width: clamp(6.5rem, 24vw, 9.5rem);
    min-width: 6.5rem;
    padding: 0.15rem 0.5rem 0.15rem 0.15rem;
  }

  .intro-audio-art-disc {
    width: min(100%, 9.5rem);
    aspect-ratio: 1;
    max-height: 100%;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid color-mix(in srgb, var(--border) 55%, var(--accent) 45%);
    box-shadow: 0 3px 14px color-mix(in oklab, #000 14%, transparent);
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .intro-audio-wrap.playing .intro-audio-art-disc {
    border-color: var(--accent);
    box-shadow:
      0 3px 14px color-mix(in oklab, #000 14%, transparent),
      0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent),
      0 8px 28px -6px color-mix(in oklab, var(--accent) 40%, transparent);
    animation: intro-art-spin 24s linear infinite;
  }

  .intro-audio-art-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-audio-wrap.playing .intro-audio-art-disc {
      animation: none;
    }
  }

  @keyframes intro-art-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .intro-audio-body {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.35rem;
    padding-left: 0.1rem;
  }

  .intro-audio-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.55rem;
  }

  .intro-audio-mid {
    margin: 0;
    min-width: 0;
  }

  .intro-audio-bottom {
    display: block;
  }

  .intro-audio-progress-wrap {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
  }

  .intro-audio-prefix {
    color: var(--accent);
    opacity: 0.42;
    user-select: none;
    font-size: 1.05em;
    transition: opacity 0.35s ease;
  }
  .intro-audio-cmd {
    color: var(--accent);
    opacity: 0.52;
    user-select: none;
    letter-spacing: 0.03em;
    font-size: 1.02em;
    transition: opacity 0.35s ease;
  }

  .intro-audio-wrap.playing .intro-audio-prefix {
    opacity: 0.72;
  }
  .intro-audio-wrap.playing .intro-audio-cmd {
    opacity: 0.92;
  }

  .intro-audio-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    border-radius: 0.45rem;
    border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.15s;
  }
  .intro-audio-icon-btn:hover {
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }
  .intro-audio-icon-btn:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }
  .intro-audio-ctrl-icon {
    width: 0.78rem;
    height: 0.78rem;
  }

  .intro-audio-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--accent) 50%, transparent);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--accent);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.15s;
    outline: none;
  }

  .intro-audio-btn:hover {
    background: color-mix(in oklab, var(--accent) 22%, transparent);
    border-color: var(--accent);
    transform: scale(1.06);
  }

  .intro-audio-btn:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .intro-icon {
    width: 0.95rem;
    height: 0.95rem;
  }

  .hidden {
    display: none !important;
  }

  .intro-audio-mode-btn {
    min-width: 2.5rem;
    height: 2.1rem;
    padding: 0 0.5rem;
    border-radius: 0.4rem;
    border: 1px solid color-mix(in oklab, var(--border) 45%, transparent);
    background: color-mix(in oklab, var(--muted) 6%, transparent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--foreground);
    cursor: pointer;
    flex-shrink: 0;
  }
  .intro-audio-mode-btn[aria-pressed="true"] {
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 8%, transparent);
  }
  .intro-audio-mode-text::before {
    content: "SEQ";
  }
  .intro-audio-mode-btn.shuffle .intro-audio-mode-text::before {
    content: "RND";
  }

  .intro-audio-vol {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
  }
  .intro-audio-vol-icon {
    font-size: 0.7rem;
    line-height: 1;
    opacity: 0.4;
  }
  .intro-audio-vol-range {
    width: 5.5rem;
    min-width: 3.5rem;
    height: 0.3rem;
    cursor: pointer;
    accent-color: var(--accent);
  }

  .intro-waveform {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 1.25rem;
  }

  .intro-wave-bar {
    display: block;
    width: 3px;
    border-radius: 999px;
    background: var(--accent);
    height: 30%;
    opacity: 0.35;
    transition: opacity 0.3s;
  }

  .intro-audio-wrap.playing .intro-wave-bar {
    opacity: 0.8;
    animation: wave-bounce 0.6s ease-in-out infinite alternate;
    animation-delay: var(--delay, 0s);
  }

  @keyframes wave-bounce {
    from {
      height: 20%;
    }
    to {
      height: var(--h, 80%);
    }
  }

  .intro-progress-track {
    position: relative;
    width: 100%;
    height: 5px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--border) 38%, var(--foreground) 8%);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--foreground) 8%, transparent);
    flex-shrink: 0;
    cursor: pointer;
    overflow: hidden;
    user-select: none;
    touch-action: none;
    outline: none;
  }

  .intro-progress-track:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 4px;
    background: color-mix(in oklab, var(--border) 45%, transparent);
  }

  .intro-progress-bar {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      var(--accent) 0%,
      #0284c7 18%,
      #0ea5e9 38%,
      #22d3ee 58%,
      #8b5cf6 78%,
      #c026d3 100%
    );
    box-shadow:
      0 0 10px 0 rgba(14, 165, 233, 0.35),
      0 0 16px 0 rgba(192, 38, 211, 0.28);
    transition: width 0.25s linear;
  }

  .intro-time {
    font-variant-numeric: tabular-nums;
    font-size: 0.82rem;
    color: var(--foreground);
    opacity: 0.65;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Light: black; dark: white */
  .intro-label {
    width: 100%;
    min-width: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    user-select: none;
    text-align: left;
    margin: 0;
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #000000;
  }

  :global(html[data-theme="dark"]) .intro-label {
    color: #ffffff;
  }

  @media (max-width: 480px) {
    .intro-audio-wrap {
      min-height: 0;
      flex-direction: column;
      align-items: stretch;
    }
    .intro-audio-art-col {
      width: 100%;
      min-width: 0;
      padding: 0.25rem 0 0.4rem 0;
    }
    .intro-audio-art-disc {
      max-width: 7.5rem;
      margin: 0 auto;
    }
    .intro-label {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  import {
    getIntroAudioStore,
    storeGoNext,
    storeGoPrev,
    storeSetVolume,
    storeSetPlayMode,
    storeToggle,
    storeSeek,
    emitIntroAudioState,
    INTRO_AUDIO_STATE_EVENT,
    type IntroAudioState,
  } from "@/utils/introAudioStore";
  import { MUSIC_TRACKS } from "@/data/musicPlaylist";

  const pad = (n: number) => String(n).padStart(2, "0");
  const fmt = (secs: number) => {
    const s = Math.max(0, Math.floor(secs));
    return `${Math.floor(s / 60)}:${pad(s % 60)}`;
  };

  function initIntroAudio() {
    if (MUSIC_TRACKS.length === 0) return;
    const wrap = document.getElementById(
      "intro-audio-player"
    ) as HTMLElement | null;
    const btn = document.getElementById(
      "intro-audio-btn"
    ) as HTMLButtonElement | null;
    const btnPrev = document.getElementById(
      "intro-audio-btn-prev"
    ) as HTMLButtonElement | null;
    const btnNext = document.getElementById(
      "intro-audio-btn-next"
    ) as HTMLButtonElement | null;
    const modeBtn = document.getElementById(
      "intro-audio-mode-btn"
    ) as HTMLButtonElement | null;
    const vol = document.getElementById(
      "intro-audio-vol"
    ) as HTMLInputElement | null;
    const iconPlay = document.getElementById(
      "intro-icon-play"
    ) as SVGElement | null;
    const iconPause = document.getElementById(
      "intro-icon-pause"
    ) as SVGElement | null;
    const bar = document.getElementById(
      "intro-progress-bar"
    ) as HTMLElement | null;
    const track = document.getElementById(
      "intro-progress-track"
    ) as HTMLElement | null;
    const current = document.getElementById(
      "intro-current"
    ) as HTMLElement | null;
    const totalLabel = document.getElementById(
      "intro-total"
    ) as HTMLElement | null;
    const nowLabel = document.getElementById(
      "intro-now-label"
    ) as HTMLElement | null;
    const artImg = document.getElementById(
      "intro-audio-art-img"
    ) as HTMLImageElement | null;

    if (!wrap || !btn) return;
    if (wrap.dataset.introAudioInitialized === "true") return;
    wrap.dataset.introAudioInitialized = "true";

    const store = getIntroAudioStore();
    if (store.tracks.length === 0) return;

    const setModeUi = (m: "sequential" | "shuffle") => {
      modeBtn?.setAttribute("aria-pressed", m === "shuffle" ? "true" : "false");
      modeBtn?.setAttribute(
        "aria-label",
        m === "shuffle" ? "Playback mode: shuffle" : "Playback mode: sequential"
      );
      modeBtn?.classList.toggle("shuffle", m === "shuffle");
    };

    if (vol) {
      vol.value = String(store.audio.volume);
    }

    const setPlaying = (playing: boolean) => {
      wrap.classList.toggle("playing", playing);
      iconPlay?.classList.toggle("hidden", playing);
      iconPause?.classList.toggle("hidden", !playing);
      btn.setAttribute("aria-label", playing ? "Pause music" : "Play music");
    };

    const render = (state: IntroAudioState) => {
      setPlaying(state.playing);
      setModeUi(state.playMode);

      const total = state.duration;
      const now = state.currentTime;
      const pct = total > 0 ? (now / total) * 100 : 0;

      if (bar) bar.style.width = `${pct}%`;
      if (nowLabel) {
        nowLabel.textContent = state.label;
        nowLabel.setAttribute("title", state.label);
      }
      if (current) {
        const nowStr = fmt(now);
        if (current.textContent !== nowStr) current.textContent = nowStr;
      }
      if (track) {
        track.setAttribute("aria-valuenow", String(Math.floor(now)));
        if (total > 0) {
          track.setAttribute("aria-valuemax", String(Math.floor(total)));
        }
      }
      if (totalLabel) {
        const totalStr = total > 0 ? fmt(total) : "0:00";
        if (totalLabel.textContent !== totalStr)
          totalLabel.textContent = totalStr;
      }
      if (vol && document.activeElement !== vol) {
        if (Number(vol.value) !== state.volume)
          vol.value = String(state.volume);
      }
      if (artImg && state.artworkUrl) {
        if (artImg.getAttribute("data-artwork") !== state.artworkUrl) {
          artImg.setAttribute("data-artwork", state.artworkUrl);
          artImg.src = state.artworkUrl;
        }
      }
    };

    btn.addEventListener("click", storeToggle);
    btnPrev?.addEventListener("click", storeGoPrev);
    btnNext?.addEventListener("click", storeGoNext);
    modeBtn?.addEventListener("click", () => {
      const s = getIntroAudioStore();
      storeSetPlayMode(s.playMode === "shuffle" ? "sequential" : "shuffle");
    });
    vol?.addEventListener("input", e => {
      const v = Number((e.target as HTMLInputElement).value);
      storeSetVolume(v);
    });

    track?.addEventListener("click", (e: MouseEvent) => {
      if (!bar) return;
      const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
      const ratio = (e.clientX - rect.left) / rect.width;
      const t = getIntroAudioStore().audio.duration;
      if (t > 0) storeSeek(ratio * t);
    });

    track?.addEventListener("keydown", (e: KeyboardEvent) => {
      const a = getIntroAudioStore().audio;
      if (!Number.isFinite(a.duration) || a.duration <= 0) return;
      if (e.key === "ArrowRight" || e.key === "ArrowUp") {
        e.preventDefault();
        storeSeek(Math.min(a.currentTime + 5, a.duration));
      } else if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
        e.preventDefault();
        storeSeek(Math.max(a.currentTime - 5, 0));
      }
    });

    const controller = new AbortController();

    window.addEventListener(
      INTRO_AUDIO_STATE_EVENT,
      (event: Event) => {
        const customEvent = event as CustomEvent<IntroAudioState>;
        render(customEvent.detail);
      },
      { signal: controller.signal }
    );

    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
      },
      { once: true }
    );

    setModeUi(getIntroAudioStore().playMode);
    emitIntroAudioState(getIntroAudioStore());
  }

  initIntroAudio();
  document.addEventListener("astro:page-load", initIntroAudio);
</script>
