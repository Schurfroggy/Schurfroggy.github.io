---
/**
 * Light-mode only: fixed color swatches on the right to switch `data-bg-preset`.
 * Hidden in dark via CSS (`html[data-theme="dark"]`).
 */
import { BACKGROUND_PRESETS, type BackgroundPreset } from "@/config";

const labels: Record<BackgroundPreset, string> = {
  yellow: "淡黄",
  blue: "淡蓝",
  green: "淡绿",
  pink: "粉色",
  purple: "淡紫",
};

const swatches: Record<BackgroundPreset, string> = {
  yellow: "#fef3c7",
  blue: "#bfdbfe",
  green: "#bbf7d0",
  pink: "#fbcfe8",
  purple: "#e9d5ff",
};
---

<aside
  class="bg-preset-picker"
  aria-label="浅色背景配色"
  transition:persist="bg-preset-picker"
>
  <div
    class="bg-preset-picker__swatches"
    role="radiogroup"
    aria-label="选择浅色渐变背景"
  >
    {
      BACKGROUND_PRESETS.map(preset => (
        <button
          type="button"
          class="bg-preset-swatch"
          data-preset={preset}
          role="radio"
          aria-label={labels[preset]}
          title={labels[preset]}
          aria-checked="false"
          style={`--swatch:${swatches[preset]}`}
        >
          <span class="sr-only">{labels[preset]}</span>
        </button>
      ))
    }
  </div>
</aside>

<script>
  import { BACKGROUND_PRESETS, type BackgroundPreset } from "@/config";
  import {
    applyBgPresetFromStorage,
    setBgPreset,
  } from "@/scripts/backgroundPreset";

  function syncSwatchUI() {
    const root = document.documentElement;
    const current = root.getAttribute("data-bg-preset");
    document
      .querySelectorAll<HTMLButtonElement>(".bg-preset-swatch")
      .forEach(btn => {
        const p = btn.dataset.preset;
        const on = p === current;
        btn.setAttribute("aria-checked", on ? "true" : "false");
        btn.classList.toggle("bg-preset-swatch--active", on);
      });
  }

  function initBgPresetPicker() {
    applyBgPresetFromStorage();
    syncSwatchUI();

    const wrap = document.querySelector(
      ".bg-preset-picker"
    ) as HTMLElement | null;
    if (!wrap || wrap.dataset.bgPickerInit === "true") return;
    wrap.dataset.bgPickerInit = "true";

    wrap
      .querySelectorAll<HTMLButtonElement>(".bg-preset-swatch")
      .forEach(btn => {
        btn.addEventListener("click", () => {
          const p = btn.dataset.preset as BackgroundPreset | undefined;
          if (!p || !(BACKGROUND_PRESETS as readonly string[]).includes(p))
            return;
          setBgPreset(p);
          syncSwatchUI();
        });
      });

    window.addEventListener("site-bg-preset", syncSwatchUI);
    window.addEventListener("site-theme-reflected", syncSwatchUI);
  }

  document.addEventListener("astro:page-load", initBgPresetPicker);
</script>

<style>
  .bg-preset-picker {
    position: fixed;
    z-index: 50;
    right: 0.75rem;
    top: 50%;
    translate: 0 -50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.35rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--border) 45%, transparent);
    background: color-mix(in srgb, var(--background) 78%, transparent);
    box-shadow:
      0 4px 24px color-mix(in srgb, var(--foreground) 6%, transparent),
      0 0 0 1px color-mix(in srgb, var(--foreground) 4%, transparent) inset;
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
  }

  html[data-theme="dark"] .bg-preset-picker {
    display: none;
  }

  .bg-preset-picker__swatches {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .bg-preset-swatch {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    border: 2px solid color-mix(in srgb, var(--foreground) 18%, transparent);
    background: var(--swatch);
    cursor: pointer;
    padding: 0;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
    box-shadow: 0 1px 3px color-mix(in srgb, var(--foreground) 12%, transparent);
  }

  .bg-preset-swatch:hover {
    transform: scale(1.08);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .bg-preset-swatch:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .bg-preset-swatch--active {
    border-color: var(--accent);
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--background) 90%, transparent),
      0 0 0 4px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  @media (max-width: 640px) {
    .bg-preset-picker {
      right: 0.5rem;
      top: auto;
      bottom: 5rem;
      translate: none;
    }
  }
</style>
